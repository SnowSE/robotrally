@implements IAsyncDisposable
@inject GameService Game
@inject ArenaHost Host
@inject IJSRuntime Js

@if (Phase == GamePhase.Demo)
{
    <div class="kid-lobby">
        <h1 class="logo">Robot Rally</h1>
        <div class="lobby-racer"><CharacterIcon Look="Player.Look" Class="bob" Size="100%" Angle="-90" /></div>
        <div class="nick-pill big">@Player.Nickname</div>
        <p class="lobby-msg">👀 Look at the big screen!</p>
    </div>
}
else
{
    <div class="kid-lobby bumper">
        <header class="bumper-head">
            <h1 class="logo">Robot Rally</h1>
            <div class="bumper-me">
                <CharacterIcon Look="Player.Look" Size="46" Angle="-90" />
                <span class="nick-pill">@Player.Nickname</span>
            </div>
            <p class="lobby-msg">
                @(Phase == GamePhase.Countdown ? "Get ready…"
                    : Game.KingOfTheHill ? "You're in! Bump your friends and rule the 👑 hill." : "You're in! Drive around and bump your friends.")
            </p>
        </header>
        <Arena Players="Game.Players" MeId="@Player.Id" Class="kid-arena" />
        <p class="lobby-hint keys">
            <kbd>←</kbd><kbd>↑</kbd><kbd>↓</kbd><kbd>→</kbd> drive · the race starts soon
        </p>
    </div>
}

@code {
    [Parameter, EditorRequired] public Player Player { get; set; } = default!;
    [Parameter] public GamePhase Phase { get; set; }

    private DotNetObjectReference<KidLobby>? _ref;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _ref = DotNetObjectReference.Create(this);
        try { await Js.InvokeVoidAsync("rally.drive.start", _ref); } catch { }
    }

    [JSInvokable]
    public void Drive(int mask) => Host.Drive(Player.Id, (DriveInput)mask);

    public async ValueTask DisposeAsync()
    {
        try { await Js.InvokeVoidAsync("rally.drive.stop"); } catch { }
        _ref?.Dispose();
    }
}
