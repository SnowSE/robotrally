@inject GameService Game
@inject IJSRuntime Js

<div class="kid-done">
    <h1 class="done-title">Race over!</h1>
    <div class="done-racer"><CharacterIcon Look="Player.Look" Class="@(_place <= 3 ? "dance" : "bob")" Size="100%" Angle="-90" /></div>
    <div class="nick-pill big">@Player.Nickname</div>
    @if (Player.Finished)
    {
        <p class="done-place">You finished in <strong>@KidFinished.Ordinal(_place)</strong> place!</p>
    }
    else
    {
        <p class="done-place">You made it to <strong>level @(Player.LevelIndex + 1)</strong>. Great racing!</p>
    }
    <p class="lobby-hint">Look at the big screen for the winners.</p>
</div>

@code {
    [Parameter, EditorRequired] public Player Player { get; set; } = default!;
    private int _place;

    protected override void OnParametersSet() => _place = Game.PlaceOf(Player);

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        Js.Sfx(_place <= 3 ? "finish" : "win");
        if (_place <= 3) Js.Confetti(200);
    }
}
