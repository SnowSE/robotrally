<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Mac app's Info.plist, handed to Velopack (vpk pack plist option) instead of its generic one, so the window may
  load the game from http://localhost. The release workflow fills in __VERSION__. Keep CFBundleIdentifier as it is:
  macOS remembers firewall and other choices by it.
-->
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>Robot Rally</string>
  <key>CFBundleDisplayName</key>
  <string>Robot Rally</string>
  <key>CFBundleIdentifier</key>
  <string>io.github.snowse.robotrally</string>
  <key>CFBundleExecutable</key>
  <string>RobotRally.Desktop</string>
  <key>CFBundleIconFile</key>
  <string>robot-rally.icns</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>__VERSION__</string>
  <key>CFBundleVersion</key>
  <string>__VERSION__</string>
  <key>LSMinimumSystemVersion</key>
  <string>12.0</string>
  <key>NSPrincipalClass</key>
  <string>NSApplication</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>
</dict>
</plist>
